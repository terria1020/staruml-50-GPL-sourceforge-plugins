---
title: 이중 쓰기 2PC 적재
---
flowchart TD
    subgraph 코디네이터
        s((시작)) --> a1[복사 계획 생성]
        a1 --> d1{병합 DB 설정됨?}
        d1 -->|예| a2[복구 차단 여부 확인]
        a2 --> d2{동시 적재 자리 확보?}
        d2 -->|시간 초과| x1[INGEST_BUSY 거부]
        d2 -->|확보| f1@{ shape: fork }
        j1@{ shape: join } --> d3{양쪽 prepare 성공?}
        x2[이중 쓰기 실패 예외]
        d4{원본 커밋 대상 존재?}
        x3[적재되지 않음 예외]
        d5{병합 커밋 성공?}
        a9[오류 로그 후 복구 스위퍼에 위임]
        m1{ }
        a10[자리 반납]
        e1(((종료)))
    end
    subgraph 원본 DB 갈래
        o0[원본만 COPY 후 커밋]
        o1[원본 COPY]
        o2[PREPARE TRANSACTION]
        o3[원본 ROLLBACK PREPARED]
        o4[원본 COMMIT PREPARED]
    end
    subgraph 병합 DB 갈래
        g1[병합 COPY - 별도 스레드]
        g2[PREPARE TRANSACTION]
        g3[병합 ROLLBACK PREPARED]
        g4[병합 COMMIT PREPARED]
    end
    d1 -->|아니오| o0
    o0 --> e1
    x1 --> e1
    f1 --> o1
    f1 --> g1
    o1 --> o2
    g1 --> g2
    o2 --> j1
    g2 --> j1
    d3 -->|실패 또는 시간 초과| o3
    o3 --> g3
    g3 --> x2
    x2 --> a10
    d3 -->|성공| o4
    o4 --> d4
    d4 -->|없음| x3
    x3 --> a10
    d4 -->|있음| g4
    g4 --> d5
    d5 -->|예| m1
    d5 -->|아니오| a9
    a9 --> m1
    m1 --> a10
    a10 --> e1
